{
  "name": "ai-video-pipeline",
  "version": "1.0.0",
  "description": "AI长视频自动生成流水线 - 模块化质检+可插拔视频生成器",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:migrate": "node scripts/migrate-to-db.js",
    "upload:videos": "node scripts/upload-videos.js",
    "upload:dry": "node scripts/upload-videos.js --dry-run",
    "verify": "node scripts/verify-all.js",
    "verify:fast": "node scripts/verify-all.js --fast",
    "verify:frontend": "node scripts/verify-frontend-static.js && node scripts/verify-frontend-contract.js",
    "verify:loop": "node scripts/verify-loop.js",
    "verify:stages": "node scripts/verify-stages.js && node scripts/verify-stage-pipeline.js && node scripts/verify-continue.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "express": "^4.18.2",
    "pg": "^8.23.1",
    "ws": "^8.16.0"
  }
}
