# ===== 依赖 =====
node_modules/
npm-debug.log*
yarn-error.log*

# ===== 环境变量 / 密钥（务必忽略，泄露会被盗刷）=====
.env
.env.local
.env.*.local
*.pem
*.key

# ===== 运行时产物 =====
clips/
output/
data/tasks/
data/trash/
data/spike/
# 素材库元数据（每个片段一个 json）与波形缓存（音频峰值），均为运行时生成
data/library/
data/waveforms/
# 登录墙账号（存 scrypt 哈希；每台机器各自独立，绝不进仓库）
data/users.json
# 诊断报告（接缝分析等，含抽帧 PNG，体积大且属运行时产物）
data/reports/
*.mp4
*.mp4.txt
*.log

# ===== 大体积素材（BGM 音乐库，47MB，不进仓库）=====
# 用 assets/bgm/** 是为了连子目录（calm/ epic/ nature/ 等）一起匹配，
# 单个 * 不跨目录，会导致 mp3 被误提交。
# 需要的话用对象存储 / Git LFS 单独管理。
assets/bgm/**/*.mp3
assets/bgm/**/*.wav
assets/bgm/**/*.m4a

# BGM 播放器偏好（运行时状态，每台机器不同）
assets/bgm/prefs.json

# ===== 项目内自带的 ffmpeg 二进制（约 640MB，不进仓库）=====
# 放进 app/tools/ffmpeg/bin/ 后 config.js 会自动优先使用它，
# 不需要改系统 PATH，也不依赖开发者机器上装没装 ffmpeg。
# 新机器首次克隆后，按 tools/ffmpeg/README.md 恢复二进制即可。
tools/ffmpeg/bin/*.exe
tools/ffmpeg/bin/*.dll

# ===== 内置 ffmpeg 二进制（约 640MB，绝不进仓库）=====
# config.js 会自动探测 tools/ffmpeg/bin/，存在就用，不存在回退系统 PATH
tools/ffmpeg/bin/
tools/ffmpeg/*.exe

# ===== Tailwind 独立 CLI（约 40MB，不进仓库）=====
# 本机没有 npm，样式改用 Tailwind 官方单文件程序生成。
# 新机器恢复方式（PowerShell）：
#   node -e "fetch('https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.17/tailwindcss-windows-x64.exe').then(r=>r.arrayBuffer()).then(b=>require('fs').writeFileSync('tools/tailwind/tailwindcss.exe',Buffer.from(b)))"
# 生成样式：
#   tools/tailwind/tailwindcss.exe -c web/tailwind.config.js -i web/styles/src.css -o web/styles/app.css --minify
# 注意：web/vendor/（React UMD + htm，约 150KB）刻意入库，新机器 clone 后直接可跑。
tools/tailwind/*.exe

# ===== 本地临时文件 =====
_e2e_*.js
.DS_Store
Thumbs.db
.idea/
.vscode/
data/keep/

# 剪映调节复刻的 cube 缓存（运行时产物）
data/adjust/
