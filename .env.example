# ==========================================
# 环境变量模板 - 复制为 .env 后填写
# ==========================================
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，绝不会进 Git
# ⚠️ 云平台部署时，把下面需要的行填进平台的"环境变量"面板
# ==========================================

# ===== 视频生成模型 API Key（用哪个填哪个，留空则走 Mock 模式）=====
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_ID=agnes-video-2.5

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_ID=Wan-AI/Wan2.2-T2V-A14B

SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://www.seeddance.io/v1
SEEDANCE_MODEL=seedance-2.5

KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v3

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL_ID=wan3.0-video

# ===== 图片生成 / 图生视频（「先图后视频」工作流）=====
# ⚠️ 当前状态：仅预留配置位，代码尚未接入厂商（src/generators/imageGen.js）。
#    填了也不会生效，等后端改造完成后才可用。现在填好只是省得以后再翻一次。
#
# 组合方式：
#   A) 一家的 Key 同时能做文生图 + 图生视频（如阿里百炼、硅基流动）
#      → 只填 IMAGE_GEN_* 三行，I2V_* 全部留空（自动回退同一 Key/BaseUrl）
#   B) 两家不同厂商
#      → IMAGE_GEN_* 一家，I2V_* 另一家，各自填
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_TIMEOUT_MS=180000

I2V_PROVIDER=
I2V_API_KEY=
I2V_BASE_URL=
I2V_MODEL=

# ===== 大语言模型（提示词优化 / 视觉质检）=====
# ⚠️ 同时被「视觉内容质检」和「NSFW 合规检测」使用。
#    这两项都属于合规/质量红线：Key 为空时对应检测项会判 fail（不会默认通过），
#    生产环境请务必配置一个支持图像输入的多模态模型。
#
# 优先级：页面「设置」里填的 > 这里的 .env。
# 建议：把 Key 只配在这里一次即可——页面的设置存在浏览器 localStorage，
#      换地址（localhost↔127.0.0.1）、换端口、清站点数据都会丢，导致反复重填。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 多模态视觉模型的 key / baseUrl 可独立配置（留空则回退到上面的 OPENAI_*）。
# 因为文本模型和视觉模型常常不是同一家厂商：
#   文本 DeepSeek + 视觉 阿里云百炼 的组合写法：
#     OPENAI_API_KEY=sk-DeepSeek的key
#     OPENAI_BASE_URL=https://api.deepseek.com/v1
#     OPENAI_MODEL=deepseek-chat
#     MULTIMODAL_API_KEY=sk-阿里云百炼的key
#     MULTIMODAL_BASE_URL=https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
#     OPENAI_MULTIMODAL_MODEL=qwen-vl-plus
# 注意：DeepSeek 不支持图像输入，不能拿它做 NSFW 检测。
# 阿里云百炼的视觉模型必须用「带 WorkspaceId 的专属接入点」（与视频生成同一业务空间，
# 只是路径为 /compatible-mode/v1）。旧的通用入口 dashscope.aliyuncs.com/compatible-mode/v1
# 对业务空间 Key 会返回 403 Model.AccessDenied。
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=
OPENAI_MULTIMODAL_MODEL=gpt-4o-mini

# ===== 摄影级风光规则层（fengguang skill）=====
# 走 AI 优化时，风光类主题会追加一份「摄影级自然风光」规则段
# （data/skill-fengguang.rules.md，可自行编辑，下次调用生效）。
# 作用域：landscape / mountain / desert / lake / ocean / waterfall / aurora / space；
#         城市夜景(city)与「无主题」不追加。
# 设为 false 可整体关闭，回退到原有提示词行为。
# 注意：这一段只在「AI 优化」路径生效（任务带 llmApiKey）；
#       没配 Key 时走模板词池，不读本节。
SKILL_PROMPT_ENABLED=true

# ===== NSFW 合规检测 =====
# 置信度阈值，取值 0 ~ 1。模型判定的 NSFW 置信度 大于等于 此值即判「不合规」（fail）。
# 默认 0.8，对应《项目需求申报表》承诺的合规红线。
# 非法值（非数字 / 负数 / >1）会回退到 0.8 并在启动时打印警告。
# 改动后需重启服务（配置在进程启动时求值）。
QC_NSFW_THRESHOLD=0.8

# ===== 无缝循环 =====
# 首尾交叉淡化时长（秒），取值 (0, 10]。默认 0.5。
# 成片会比拼接产物短这个时长（真无缝的必然代价：首尾必须重叠）。
# 0.5 的取舍：能看出是「化过去」而非「跳过去」，又不至于让首尾差异大的画面双重曝光。
LOOP_FADE_DURATION=0.5

# 循环质检：产物【末尾】与【开头】的 SSIM 阈值，取值 0 ~ 1。默认 0.9。
# 实测参考（35s 样片）：直通 ≈0.50，真淡化 0.5s ≈0.95。
# 非法值（非数字 / 负数 / >1）会回退到 0.9 并在启动时打印警告。
QC_LOOP_SSIM_THRESHOLD=0.9

# ===== 片段间转场（交叉淡化）=====
# 与「无缝循环」是两件事：循环处理成片尾部回绕到开头，这里处理每两个相邻片段的接缝。
# 开启后成片时长 = Σ片段时长 − (N−1)×TRANSITION_DURATION，比原来短。
# **默认 true（2026-10-27 起）**：实测硬切成片接缝相邻帧 SSIM 仅 0.42~0.54，
# 开 0.4s 淡化后 0.83~0.95；代价 47s 样本 8.13s → 11.36s，30 分钟成片约 5.2 → 7.3 分钟。
# 依据见 docs/spec/seam-quality-spec.md §9。改 false 可回到 -c copy 直拼（最快）。
# 注意：`quick` 档不看这个开关，始终走 -c copy（pipeline._transitionOptions 强制）。
TRANSITION_ENABLED=true
# 淡化时长（秒），取值 [0.1, 5]。默认 0.4。
# 片段过短时会自动收窄到「最短片段/2 − 0.05」；低于 0.1 则判失败，不静默直通。
TRANSITION_DURATION=0.4
# 转场类型：fade（交叉淡化，默认）/ dissolve / wipeleft / wiperight / slideleft /
# slideright / circleopen / pixelize / fadeblack / fadewhite。
TRANSITION_TYPE=fade
# 编码器：auto（默认，依次探测 nvenc/qsv/amf，不可用回退 libx264）/ libx264 / nvenc / qsv / amf。
# 硬件编码明显更快，但同码率下画质与体积可能不同；画质优先时可显式设 libx264。
TRANSITION_ENCODER=auto

# ===== 镜头级色彩连续性（colorContinuity 质检项，2026-10-27 新增）=====
# 与「接缝质检」不同：接缝质检只测缝中心帧（转场开启时那是混合帧），
# 这里测「缝前 0.6s vs 缝后 0.6s」两个镜头本身的 ΔE76，用来抓「镜头整体色调跳变」。
# 实测依据 docs/spec/re-jianying/seam-experiment.md：合格组 1.4~3.6，不连贯组 25~48。
# 三档：≤WARN 通过；WARN~MAX 记「提示」(不拉低通过率)；>MAX 判失败。
# 中间留提示档是因为「日落→蓝调」这类冷暖对比可能是刻意创作。
QC_COLOR_DE76_WARN=15
QC_COLOR_DE76_MAX=40

# ===== 拼接时自动校色（默认关）=====
# 只在「转场开启」的重编码路径生效（不额外多一次编码）；关掉转场走 -c copy 时不校色。
# **默认 false**：它会改变画面观感，必须显式开启；开启后任务里 colorMatch 未开也会如实报「未执行」。
# 注意：任务要求校色但转场关闭属于互斥组合，创建任务时应直接拒绝（不要等出片后再判失败）。
COLOR_MATCH_ENABLED=false
# 单通道增益最大偏离，超出只告警不强行拉（防止把画面拉坏）。
COLOR_MATCH_MAX_GAIN=0.15

# 换成 DeepSeek 的写法：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ===== 数据库（存储任务、提示词、视频元数据）=====
# 留空 = 继续用本地 JSON 文件（向后兼容）
# 推荐 Supabase / Neon 免费 Postgres，示例：
#   DATABASE_TYPE=postgres
#   DATABASE_URL=postgresql://postgres:密码@db.xxxx.supabase.co:5432/postgres
DATABASE_TYPE=
DATABASE_URL=

# ===== 对象存储（视频、BGM 等大文件）=====
# 留空 = 只用本地磁盘，不上传
# STORAGE_DRIVER：supabase | s3 | (空)
#
# Supabase Storage 填法（免费 1GB，不用绑卡）：
#   STORAGE_DRIVER=supabase
#   SUPABASE_SERVICE_KEY 用 service_role key（不是 anon key）
#
# Cloudflare R2 填法（免费 10GB，需绑卡）：
#   STORAGE_DRIVER=s3
#   S3_ENABLED=true
#   S3_REGION=auto
#   S3_ENDPOINT=https://你的账号ID.r2.cloudflarestorage.com
STORAGE_DRIVER=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=videos

# S3 兼容（Cloudflare R2 / 阿里云 OSS 也适用）
S3_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# ===== FFmpeg =====
# 留空 = 用系统 PATH 里的 ffmpeg（云上 Linux 容器推荐 apt install ffmpeg）
# Windows 本地开发示例：
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#   FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=
FFPROBE_PATH=

# ===== 服务器 =====
# 云平台会自动注入 PORT，本地不用改
PORT=3000
WEBSOCKET=true
# 公网部署时设置访问口令，防止别人盗刷你的 AI 额度
ACCESS_TOKEN=

# ===== 登录墙 =====
# 是否启用登录。跑验收脚本时可临时设 false，平时不要关。
AUTH_ENABLED=true
# 首次启动创建第一个账号用；账号建好之后以数据库/JSON 里的为准，改这两行不再生效
AUTH_USER=admin
# 留空 = 首次启动随机生成一个密码并打印在终端（只打印一次）
AUTH_PASSWORD=
# 会话绝对过期小时数。cookie 本身是会话级（关浏览器即失效），这里只是兜底上限
AUTH_SESSION_HOURS=8
# 连续登录失败几次锁 IP、锁多少分钟
AUTH_MAX_FAILS=5
AUTH_LOCK_MINUTES=5
# 新建账号的密码最短长度
AUTH_MIN_PASSWORD_LENGTH=8

# ===== 生成参数 =====
GEN_CONCURRENCY=3
GEN_MAX_RETRIES=1
GEN_CLIP_DURATION=15
GEN_RESOLUTION=1080p

# ===== 存储目录 =====
CLIPS_DIR=./clips
OUTPUT_DIR=./output
DATA_DIR=./data/tasks
# 剪辑台工程（草稿）存储目录；与任务存储分开
PROJECTS_DIR=./data/projects
# 素材缩略图缓存目录（剪辑台素材栏/时间线）
THUMBS_DIR=./data/thumbnails

# ===== 剪映「调节」复刻 =====
# 默认关闭。开启后，任务带 adjust 参数才会在最终转码时套用。
# 参数范围：基础滑杆 -50..50；HSL -100..100；色轮 -1..1
# 算法与对照验证见 docs/spec/re-jianying/jy-adjust.md
ADJUST_ENABLED=false
# cube 缓存目录（运行时产物，不入库）
ADJUST_CUBE_DIR=./data/adjust
# 缓存过期小时数，0 = 不清理
ADJUST_CUBE_MAX_AGE_HOURS=24

# ===== 配乐响度 / 闪避 =====
# 全局默认响度（LUFS，越接近 0 越响）。-16 ≈ 电视/流媒体常用；-20 更轻。
# 任务级 bgm.volume 优先；旧任务文件里已存的值不受影响。
BGM_LOUDNESS=-16
# 环境声出现时自动压低音乐（sidechaincompress）。默认关闭，不影响既有成片。
# 只有同时存在 music + ambient 两条轨时才生效；只有一条轨时自动跳过。
# 触发阈值（线性 0.001~1，越小越灵敏）、压缩比（1~20）、攻击/释放（毫秒）、补偿增益（1~20）
BGM_DUCKING_ENABLED=false
BGM_DUCK_THRESHOLD=0.05
BGM_DUCK_RATIO=4
BGM_DUCK_ATTACK_MS=20
BGM_DUCK_RELEASE_MS=500
BGM_DUCK_MAKEUP=1