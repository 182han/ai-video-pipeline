# ==========================================
# 环境变量模板 - 复制为 .env 后填写
# ==========================================
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，绝不会进 Git
# ⚠️ 云平台部署时，把下面需要的行填进平台的"环境变量"面板
# ==========================================

# ===== 视频生成模型 API Key（用哪个填哪个，留空则走 Mock 模式）=====
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_ID=agnes-video-2.5

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_ID=Wan-AI/Wan2.2-T2V-A14B

SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://www.seeddance.io/v1
SEEDANCE_MODEL=seedance-2.5

KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v3

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL_ID=wan3.0-video

# ===== 大语言模型（提示词优化 / 视觉质检）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MULTIMODAL_MODEL=gpt-4o-mini

# 换成 DeepSeek 的写法：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ===== 数据库（存储任务、提示词、视频元数据）=====
# 留空 = 继续用本地 JSON 文件（向后兼容）
# 推荐 Supabase / Neon 免费 Postgres，示例：
#   DATABASE_TYPE=postgres
#   DATABASE_URL=postgresql://postgres:密码@db.xxxx.supabase.co:5432/postgres
DATABASE_TYPE=
DATABASE_URL=

# ===== 对象存储（视频、BGM 等大文件）=====
# 留空 = 存本地磁盘。云上建议用 Supabase Storage（免费 1GB）
# STORAGE_DRIVER=supabase
STORAGE_DRIVER=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=videos

# S3 兼容（Cloudflare R2 / 阿里云 OSS 也适用）
S3_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# ===== FFmpeg =====
# 留空 = 用系统 PATH 里的 ffmpeg（云上 Linux 容器推荐 apt install ffmpeg）
# Windows 本地开发示例：
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#   FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=
FFPROBE_PATH=

# ===== 服务器 =====
# 云平台会自动注入 PORT，本地不用改
PORT=3000
WEBSOCKET=true
# 公网部署时设置访问口令，防止别人盗刷你的 AI 额度
ACCESS_TOKEN=

# ===== 生成参数 =====
GEN_CONCURRENCY=3
GEN_MAX_RETRIES=1
GEN_CLIP_DURATION=15
GEN_RESOLUTION=1080p

# ===== 存储目录 =====
CLIPS_DIR=./clips
OUTPUT_DIR=./output
DATA_DIR=./data/tasks
